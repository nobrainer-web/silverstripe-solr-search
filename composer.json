    "type": "silverstripe-vendormodule",
    "keywords": [
        "silverstripe",
        "solr",
        "search"
    ],
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "Sander Hagenaars",
            "email": "sander@nobrainer.dk"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": "^8.3",
        "silverstripe/cms": "^6",
        "silverstripe/fulltextsearch": "^5"
    },
    "autoload": {
        "psr-4": {
            "NobrainerWeb\\Solr\\": "src/"
        }
    }
